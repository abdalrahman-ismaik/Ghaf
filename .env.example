# Feature 003 runs entirely with deterministic local providers.
# This setting is optional because `mock` is the built-in default.
EXPO_PUBLIC_GHAF_SERVICE_MODE=mock

# Feature 006 adult pilot accounts. The competition default remains demo.
# Set supabase only in a separately configured pilot build after its evidence gates.
EXPO_PUBLIC_GHAF_AUTH_MODE=demo
# Public project configuration; never use a secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Features 016/017 family messaging use a separate team-test project.
# Keep empty until both SQL migrations, Auth setup and retention are verified.
# Only HTTPS URL and sb_publishable_ key; never use the adult pilot project here.
EXPO_PUBLIC_GHAF_MESSAGING_URL=
EXPO_PUBLIC_GHAF_MESSAGING_PUBLISHABLE_KEY=

# An optional bounded Parent Guide adapter exists, but this competition configuration does not
# activate it. Activation requires an approved HTTPS gateway and trusted credential injection.
# Never place provider or gateway secrets in an EXPO_PUBLIC variable or the mobile bundle.

# Feature 004 implementation switches are independent and fail closed. Keep all three false in
# competition and release builds until their separate activation evidence gates pass.
EXPO_PUBLIC_GHAF_AI_PARENT_TASK_DRAFTING_LIVE=false
EXPO_PUBLIC_GHAF_AI_CHILD_COACH_TEXT_LIVE=false
EXPO_PUBLIC_GHAF_AI_CHILD_COACH_VOICE_LIVE=false
