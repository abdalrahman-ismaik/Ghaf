{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ghaf-parent-guide-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "PARENT_GUIDE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "ALLOWED_ORIGIN": "https://replace-with-approved-demo-origin.invalid",
  },
  "secrets": {
    "required": ["GHAF_DEMO_ACCESS_TOKEN"],
  },
}
